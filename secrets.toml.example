# ============================================================
# JianpuTool 授權碼設定範本
# ============================================================
#
# 使用方式：
#   1. 複製這個檔案，改名為 secrets.toml，放在同一個資料夾（.streamlit/secrets.toml）
#   2. 部署到 Streamlit Community Cloud 時，
#      不要上傳 secrets.toml，改在網站後台：
#      App -> Settings -> Secrets，把下面內容貼進去
#   3. 每個月要收 99 元的訂閱費時，把當月授權碼加進 ACCESS_CODES 清單即可
#
# 授權碼格式說明：
#   "任意字串"              -> 永久有效，除非你從清單刪除
#   "任意字串:2026-08"      -> 只在 2026-08（西元年-月）這個月有效
#                              建議每月訂閱都用這種格式，過月自動失效
#
# ============================================================

ACCESS_CODES = [
    "JIANPU-2026-08:2026-08",
    "VIP-DEMO:2026-08",
]
